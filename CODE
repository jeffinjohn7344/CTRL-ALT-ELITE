class EnhancedProofAnalyst:

    def __init__(self, csv_filepath: str, api_key: str = None):
        self.filepath = csv_filepath
        self.df = pd.read_csv(csv_filepath)
        # Clean column names
        self.df.columns = self.df.columns.str.strip()

        # Build dynamic Index of categorical values present in the dataset
        self.value_index = {}
        for col in self.df.select_dtypes(include=["object", "category"]).columns:
            unique_vals = set(self.df[col].dropna().unique())
            self.value_index[col] = {
                val.lower(): val for val in unique_vals if isinstance(val, str)
            }

        # Dual engine: In-memory SQLite database
        self.conn = sqlite3.connect(":memory:")
        self.df.to_sql("sales", self.conn, index=False, if_exists="replace")

        # Initialize Audit Ledger
        self.ledger = CryptographicAuditLedger(self.conn)

        self.api_key = api_key or os.getenv("OPENAI_API_KEY")
        if HAS_OPENAI and self.api_key:
            self.client = openai.OpenAI(api_key=self.api_key)
        else:
            self.client = None

    # -----------------------------------------------------------------
    # ENHANCED DATA HYGIENE & ANOMALY DETECTION
    # -----------------------------------------------------------------
    def check_data_hygiene(self, code: str, result_subset: Optional[pd.DataFrame] = None) -> list:
        warnings = []
        for col in self.df.columns:
            if col.lower() in code.lower():
                null_cnt = int(self.df[col].isnull().sum())
                if null_cnt > 0:
                    pct = (null_cnt / len(self.df)) * 100
                    warnings.append(
                        f"Missing Data: Column '{col}' contains {null_cnt} missing values ({pct:.1f}%). Safe aggregation applied."
                    )

                # Statistical Outlier Check (IQR Method) on Numeric Columns
                if pd.api.types.is_numeric_dtype(self.df[col]):
                    valid_series = self.df[col].dropna()
                    if len(valid_series) > 10:
                        q1 = valid_series.quantile(0.25)
                        q3 = valid_series.quantile(0.75)
                        iqr = q3 - q1
                        outliers = valid_series[(valid_series < (q1 - 1.5 * iqr)) | (valid_series > (q3 + 1.5 * iqr))]
                        if not outliers.empty:
                            warnings.append(
                                f"Statistical Outlier Detected: '{col}' contains {len(outliers)} anomalous values (e.g. {outliers.iloc[0]})."
                            )
        return warnings

    # -----------------------------------------------------------------
    # ENHANCED TRAP VALIDATION & BOUNDARY GUARD
    # -----------------------------------------------------------------
    def validate_trap_question(self, question: str) -> Tuple[bool, str]:
        q_lower = question.lower()
        existing_cols = [c.lower() for c in self.df.columns]

        # Trap 1: Requesting non-existent metrics
        if any(term in q_lower for term in ["profit", "cost", "margin", "tax", "salary"]):
            if not any(c in existing_cols for c in ["cost", "profit", "margin", "tax", "salary"]):
                return (
                    False,
                    f"REFUSAL: The dataset lacks financial/cost metrics. (Available columns: {list(self.df.columns)})",
                )

        # Trap 2: Out of range date queries
        if any(year in q_lower for year in ["2025", "2026", "2030"]):
            min_d, max_d = (
                (self.df["Date"].min(), self.df["Date"].max())
                if "Date" in self.df.columns
                else ("N/A", "N/A")
            )
            return (
                False,
                f"REFUSAL: Requested timeframe is outside dataset range ({min_d} to {max_d}).",
            )

        # Trap 3: Non-existent entities
        for term in ["employee", "customer", "store", "manager", "supplier"]:
            if term in q_lower:
                return (
                    False,
                    f"REFUSAL: Entity '{term}' does not exist in schema. Available columns: {list(self.df.columns)}",
                )

        # Trap 4: Value-Level Validation
        words = re.findall(r"\b[A-Za-z]+\b", question)
        for col, val_map in self.value_index.items():
            if col.lower() in q_lower:
                found_match = any(word.lower() in val_map for word in words)
                if not found_match and len(words) > 3:
                    valid_opts = list(val_map.values())
                    return (
                        False,
                        f"REFUSAL: Requested value for '{col}' was not found. Available options for {col}: {valid_opts}",
                    )

        return True, "Valid"

    # -----------------------------------------------------------------
    # EXTENDED DETERMINISTIC LOCAL RULE-BASED PARSER
    # -----------------------------------------------------------------
    def _dynamic_local_generator(self, question: str) -> Tuple[bool, str, str, str]:
        q = question.lower()

        # Target Column
        target_col = None
        if "revenue" in q:
            target_col = "Revenue"
        elif "unit" in q or "sold" in q:
            target_col = "Units_Sold"
        elif "discount" in q:
            target_col = "Discount_Pct"

        if not target_col:
            return (
                False,
                "",
                "",
                "UNPARSEABLE_QUERY: Could not identify target metric (Revenue, Units_Sold, Discount_Pct) in question.",
            )

        # Filters
        filters, sql_filters = [], []
        for col, val_map in self.value_index.items():
            for val_lower, val_actual in val_map.items():
                if val_lower in q:
                    filters.append(f"(df['{col}'] == '{val_actual}')")
                    sql_filters.append(f"{col} = '{val_actual}'")

        # Aggregation
        agg, sql_agg = "sum", "SUM"
        if any(w in q for w in ["average", "avg", "mean"]):
            agg, sql_agg = "mean", "AVG"
        elif any(w in q for w in ["highest", "max", "maximum"]):
            agg, sql_agg = "max", "MAX"
        elif any(w in q for w in ["lowest", "min", "minimum"]):
            agg, sql_agg = "min", "MIN"
        elif "count" in q:
            agg, sql_agg = "count", "COUNT"

        # Check for Group By request
        group_col = None
        if "by category" in q:
            group_col = "Category"
        elif "by region" in q:
            group_col = "Region"

        if group_col:
            p_code = f"result = df.groupby('{group_col}')['{target_col}'].{agg}().to_dict()"
            s_code = f"SELECT json_group_object({group_col}, {sql_agg}({target_col})) FROM sales GROUP BY {group_col};"
            if filters:
                filter_str = " & ".join(filters)
                p_code = f"result = df[{filter_str}].groupby('{group_col}')['{target_col}'].{agg}().to_dict()"
                s_code = f"SELECT json_group_object({group_col}, {sql_agg}({target_col})) FROM sales WHERE {' AND '.join(sql_filters)} GROUP BY {group_col};"
        else:
            if filters:
                filter_str = " & ".join(filters)
                p_code = f"result = df[{filter_str}]['{target_col}'].{agg}()"
                s_code = f"SELECT {sql_agg}({target_col}) FROM sales WHERE {' AND '.join(sql_filters)};"
            else:
                p_code = f"result = df['{target_col}'].{agg}()"
                s_code = f"SELECT {sql_agg}({target_col}) FROM sales;"

        return True, p_code, s_code, ""

    # -----------------------------------------------------------------
    # CODE GENERATION WITH SELF-HEALING REFLECTION
    # -----------------------------------------------------------------
    def generate_proof_codes(
        self, question: str, previous_error: Optional[str] = None
    ) -> Tuple[bool, str, str, str]:
        if not self.client:
            return self._dynamic_local_generator(question)

        schema = f"""
Table name: 'sales'
Columns & Types:
{self.df.dtypes.to_string()}

Categorical Values Present:
{json.dumps({k: list(v.values()) for k, v in self.value_index.items()})}
"""
        error_context = ""
        if previous_error:
            error_context = f"\nPREVIOUS ATTEMPT FAILED WITH ERROR:\n{previous_error}\nPlease fix the generated code."

        prompt = f"""
You are a Proof-Carrying Data Analyst.
Given this schema:
{schema}

Generate BOTH Pandas Python code AND a SQL query (SQLite syntax) to answer: "{question}"{error_context}

CRITICAL RULES:
1. Store final answer in Python variable 'result'.
2. If the answer requires visualization/plotting, also generate Python code storing matplotlib figure in 'fig'.
3. Respond ONLY with valid JSON:
{{
    "pandas_code": "result = df[df['Category'] == 'Electronics']['Revenue'].sum()",
    "sql_query": "SELECT SUM(Revenue) FROM sales WHERE Category = 'Electronics';",
    "visualization_code": "fig, ax = plt.subplots(); df.groupby('Category')['Revenue'].sum().plot(kind='bar', ax=ax); plt.tight_layout()"
}}
"""
        try:
            res = self.client.chat.completions.create(
                model="gpt-4o-mini",
                messages=[{"role": "user", "content": prompt}],
                response_format={"type": "json_object"},
                temperature=0.0,
            )
            data = json.loads(res.choices[0].message.content)
            return (
                True,
                data.get("pandas_code", ""),
                data.get("sql_query", ""),
                data.get("visualization_code", ""),
            )
        except Exception:
            return self._dynamic_local_generator(question)

    # -----------------------------------------------------------------
    # SAFE EXECUTION ENGINE & VISUALIZATION GENERATOR
    # -----------------------------------------------------------------
    def execute_pandas_safely(
        self, code: str, viz_code: str = ""
    ) -> Tuple[bool, Any, Optional[str], str]:
        try:
            tree = ast.parse(code + "\n" + viz_code)
            checker = ASTSafetyGuard()
            checker.visit(tree)
            if not checker.is_safe:
                return (
                    False,
                    None,
                    None,
                    f"AST Sandbox Violation: {', '.join(checker.violations)}",
                )
        except SyntaxError as se:
            return False, None, None, f"Syntax Error: {str(se)}"

        scope = {"df": self.df.copy(), "pd": pd, "np": np, "plt": plt}
        try:
            exec(code, scope)
            res = scope.get("result", None)

            if pd.isna(res) or res is None or res == "NOT_IN_DATASET":
                return (
                    False,
                    None,
                    None,
                    "NO_MATCHING_DATA: Query executed but returned no results.",
                )

            # Process Plot/Chart if generated
            b64_image = None
            if viz_code:
                try:
                    exec(viz_code, scope)
                    fig = scope.get("fig", plt.gcf())
                    buf = io.BytesIO()
                    fig.savefig(buf, format="png", bbox_inches="tight")
                    buf.seek(0)
                    b64_image = base64.b64encode(buf.read()).decode("utf-8")
                    plt.close(fig)
                except Exception:
                    b64_image = None  # Plotting optional non-fatal failure

            return True, res, b64_image, ""
        except Exception as e:
            return False, None, None, traceback.format_exc()

    def execute_sql(self, sql_query: str) -> Tuple[bool, Any, str]:
        try:
            cur = self.conn.cursor()
            cur.execute(sql_query)
            rows = cur.fetchall()
            if not rows:
                return True, None, ""
            
            # Convert JSON string responses if SQLite json_group_object was used
            if len(rows) == 1 and len(rows[0]) == 1:
                val = rows[0][0]
                if isinstance(val, str) and (val.startswith("{") or val.startswith("[")):
                    try:
                        val = json.loads(val)
                    except json.JSONDecodeError:
                        pass
                return True, val, ""
            return True, rows, ""
        except Exception as e:
            return False, None, str(e)

    # -----------------------------------------------------------------
    # CERTIFICATE & HTML REPORT BUILDERS
    # -----------------------------------------------------------------
    def build_audit_certificate(
        self,
        question: str,
        pandas_code: str,
        sql_query: str,
        p_res: Any,
        s_res: Any,
        consensus: bool,
        b64_viz: Optional[str] = None,
    ) -> dict:
        timestamp = datetime.datetime.now(datetime.timezone.utc).isoformat()
        raw_payload = f"{question}|{pandas_code}|{sql_query}|{p_res}|{timestamp}"
        cert_hash = hashlib.sha256(raw_payload.encode("utf-8")).hexdigest()

        cert = {
            "certificate_id": f"PROOF-SHA256-{cert_hash[:12].upper()}",
            "timestamp": timestamp,
            "question": question,
            "pandas_proof_code": pandas_code,
            "sql_proof_query": sql_query,
            "pandas_result": p_res,
            "sql_result": s_res,
            "dual_engine_consensus": bool(consensus),
            "signature_hash": cert_hash,
            "visualization_b64": b64_viz,
        }
        
        # Save certificate into append-only cryptographic ledger
        return self.ledger.append_certificate(cert)

