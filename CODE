    # -----------------------------------------------------------------
    # MAIN QUERY PIPELINE WITH AUTOCORRECT RETRIES
    # -----------------------------------------------------------------
    def ask(self, question: str, max_retries: int = 2) -> Dict[str, Any]:
        # Step 1: Trap & Value Guardrail Check
        valid, refusal_msg = self.validate_trap_question(question)
        if not valid:
            return {
                "question": question,
                "status": "REFUSED_TRAP",
                "reason": refusal_msg,
            }

        # Step 2: Self-Healing Code Generation and Execution Loop
        last_err = None
        for attempt in range(max_retries + 1):
            success, pandas_code, sql_query, viz_code = self.generate_proof_codes(
                question, previous_error=last_err
            )
            if not success:
                return {
                    "question": question,
                    "status": "UNPARSEABLE_QUERY",
                    "reason": pandas_code,
                }

            # Step 3: AST Security Check & Execution
            p_ok, p_res, b64_viz, p_err = self.execute_pandas_safely(pandas_code, viz_code)
            if not p_ok:
                last_err = f"Pandas Execution Error: {p_err}"
                if attempt < max_retries:
                    continue
                return {
                    "question": question,
                    "status": "EXECUTION_REFUSED",
                    "reason": p_err,
                    "pandas_code": pandas_code,
                }

            # Step 4: Execute SQL Engine
            s_ok, s_res, s_err = self.execute_sql(sql_query)

            # Step 5: Dual Consensus Verification
            consensus = False
            if p_ok and s_ok and p_res is not None and s_res is not None:
                try:
                    if isinstance(p_res, dict) and isinstance(s_res, dict):
                        consensus = p_res == s_res
                    else:
                        consensus = bool(
                            np.isclose(
                                float(p_res), float(s_res), rtol=1e-2, equal_nan=True
                            )
                        )
                except (ValueError, TypeError):
                    consensus = bool(str(p_res).strip() == str(s_res).strip())

            # Step 6: Data Hygiene & Outlier Warnings
            warnings = self.check_data_hygiene(pandas_code)

            # Step 7: Build Cryptographic Certificate & Ledger Entry
            cert = self.build_audit_certificate(
                question, pandas_code, sql_query, p_res, s_res, consensus, b64_viz
            )

            res_payload = {
                "question": question,
                "status": "VERIFIED_PROOF",
                "calculated_result": p_res,
                "dual_consensus_match": consensus,
                "data_quality_warnings": warnings,
                "audit_certificate": cert,
            }

            res_payload["html_report"] = self.generate_html_report(res_payload)
            return res_payload


