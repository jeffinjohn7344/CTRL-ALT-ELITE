# 1. MESSY DATASET GENERATOR
# =====================================================================
def generate_messy_csv(filename: str = "sales_data_messy.csv"):
    np.random.seed(42)
    n_rows = 120
    dates = pd.date_range(start="2023-01-01", periods=n_rows, freq="D")

    df = pd.DataFrame(
        {
            " Transaction_ID ": [
                f"TXN-{1000 + i}" for i in range(n_rows)
            ],  # Dirty whitespace
            "Date": dates.strftime("%Y-%m-%d"),
            "Region": np.random.choice(
                ["North", "South", "East", "West", None],
                size=n_rows,
                p=[0.25, 0.25, 0.2, 0.2, 0.1],
            ),
            "Category": np.random.choice(
                ["Electronics", "Clothing", "Furniture"], size=n_rows
            ),
            "Revenue": np.random.uniform(50.0, 1500.0, size=n_rows).round(2),
            "Units_Sold": np.random.randint(1, 20, size=n_rows),
            "Discount_Pct": np.random.choice([0.0, 0.05, 0.10, 0.15], size=n_rows),
        }
    )

    # Inject missing values and extreme statistical outliers for testing
    df.loc[5:12, "Revenue"] = np.nan
    df.loc[25, "Revenue"] = 25000.0  # Extreme outlier
    df.to_csv(filename, index=False)
    print(f"[Setup] Generated messy dataset '{filename}' with outliers and nulls.")


# =====================================================================
# FEATURE 1: ENHANCED AST STATIC SECURITY SANDBOX
# =====================================================================
class ASTSafetyGuard(ast.NodeVisitor):
    """Parses code AST to block unsafe calls, imports, or file operations."""

    FORBIDDEN_NODES = (
        ast.Import,
        ast.ImportFrom,
        ast.Delete,
        ast.Global,
        ast.Nonlocal,
        ast.With,
        ast.Try,
    )
    FORBIDDEN_CALLS = {
        "eval",
        "exec",
        "open",
        "__import__",
        "getattr",
        "setattr",
        "delattr",
        "system",
        "popen",
        "remove",
        "rmdir",
        "unlink",
        "shutil",
        "subprocess",
        "globals",
        "locals",
        "vars",
    }

    def __init__(self):
        self.is_safe = True
        self.violations = []

    def visit(self, node):
        if isinstance(node, self.FORBIDDEN_NODES):
            self.is_safe = False
            self.violations.append(
                f"Forbidden language construct: {type(node).__name__}"
            )
        self.generic_visit(node)

    def visit_Call(self, node):
        func_name = None
        if isinstance(node.func, ast.Name):
            func_name = node.func.id
        elif isinstance(node.func, ast.Attribute):
            func_name = node.func.attr

        if func_name and func_name in self.FORBIDDEN_CALLS:
            self.is_safe = False
            self.violations.append(f"Forbidden call: {func_name}()")
        self.generic_visit(node)


# =====================================================================
# FEATURE 2: CRYPTOGRAPHIC AUDIT LEDGER (APPEND-ONLY)
# =====================================================================
class CryptographicAuditLedger:
    """Maintains a blockchain-style append-only ledger in SQLite with SHA-256 linking."""

    def __init__(self, db_conn: sqlite3.Connection):
        self.conn = db_conn
        self._init_table()

    def _init_table(self):
        cur = self.conn.cursor()
        cur.execute(
            """
            CREATE TABLE IF NOT EXISTS audit_ledger (
                block_id INTEGER PRIMARY KEY AUTOINCREMENT,
                timestamp TEXT,
                certificate_id TEXT UNIQUE,
                previous_hash TEXT,
                block_hash TEXT,
                payload JSON
            )
            """
        )
        self.conn.commit()

    def get_latest_hash(self) -> str:
        cur = self.conn.cursor()
        cur.execute("SELECT block_hash FROM audit_ledger ORDER BY block_id DESC LIMIT 1")
        row = cur.fetchone()
        return row[0] if row else "GENESIS_BLOCK_00000000000000000000000000000000"

    def append_certificate(self, cert: dict) -> dict:
        prev_hash = self.get_latest_hash()
        timestamp = datetime.datetime.now(datetime.timezone.utc).isoformat()
        
        raw_payload = f"{prev_hash}|{timestamp}|{json.dumps(cert, cls=NumpyEncoder, sort_keys=True)}"
        block_hash = hashlib.sha256(raw_payload.encode("utf-8")).hexdigest()

        cert["previous_block_hash"] = prev_hash
        cert["ledger_block_hash"] = block_hash

        cur = self.conn.cursor()
        cur.execute(
            """
            INSERT INTO audit_ledger (timestamp, certificate_id, previous_hash, block_hash, payload)
            VALUES (?, ?, ?, ?, ?)
            """,
            (
                timestamp,
                cert["certificate_id"],
                prev_hash,
                block_hash,
                json.dumps(cert, cls=NumpyEncoder),
            ),
        )
        self.conn.commit()
        return cert


